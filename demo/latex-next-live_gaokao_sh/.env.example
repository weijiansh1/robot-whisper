# ==========================================
# Security Configuration (访问控制)
# ==========================================
#
# 安全机制说明:
# 1. 服务启动时自动生成 64 字符随机 Token
# 2. Token 输出到启动终端，供管理员使用
# 3. 用户访问网站需先在 /login 页面输入 Token
# 4. 验证成功后设置 httpOnly cookie (24小时有效)
# 5. 所有页面、API、WebSocket 都需要有效 cookie
#
# ==========================================
# Qwen-MT API Configuration
# ==========================================

# 阿里云 DashScope / Qwen API Key
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxx

# API Base URL
# 国际版 (International):
# DASHSCOPE_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 中国大陆 (China Mainland):
DASHSCOPE_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型选择 (Model Selection)
# 可选: qwen-mt / qwen-mt-turbo / qwen-mt-plus
DASHSCOPE_MODEL=qwen-mt-turbo

# ==========================================
# Translation Settings (Optional)
# ==========================================

# 源语言 (Source Language)
# SOURCE_LANG=English

# 目标语言 (Target Language)
# TARGET_LANG=Chinese

# 并行线程数 (Parallel Threads)
# THREADS=8

# 每秒请求数限制 (Queries Per Second)
# QPS=5.0

# ==========================================
# Terminology Memory (Optional)
# 术语记忆库 - JSON 格式
# ==========================================
# TM_LIST=[{"source": "neural network", "target": "神经网络"}, {"source": "machine learning", "target": "机器学习"}]
