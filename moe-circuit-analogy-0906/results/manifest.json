  "bundle": "moe-circuit-analogy-0906",
  "graph_construction": {
    "conductance": "w_ij = max(C_ij, 0) for i != j",
    "ground": "state token, leak g_i = 1 - C_ii = G_{0i}^2",
    "negative_entries": "kept as the positive part; discarded |mass| fraction is 4.7e-7 of total off-diagonal |mass| on both cohorts",
    "object": "Schur complement of the sqrt-probability Gram over the 11 tokens with respect to the state token, at the final flow step",
    "sign_of_partial_form": "partial_ij = C_ij / sqrt(C_ii C_jj) with C_ii > 0, so sign(partial) == sign(conditional); the same audit covers both"
  },
  "pipeline": [
    {
      "command": "python extract_circuit_features.py --workers 12",
      "labels_used": false,
      "reads": [
        "VLA_MUI_HUB/cache_new/HiMoE-VLA/<suite>/<task>/<run_id>/server/routes.zarr:hb_router_probs",
        "moe-hb-front-back-0905/results/layer_graphs/*.npz (episode index only)"
      ],
      "script": "experiments/extract_circuit_features.py",
      "step": 1,
      "writes": [
        "results/circuit_features/*.npz",
        "results/circuit_features/extract_summary.json"
      ]
    },
    {
      "command": "python diagnose_structure.py",
      "labels_used": false,
      "script": "experiments/diagnose_structure.py",
      "step": 2,
      "writes": [
        "results/diagnostics/*"
      ]
    },
    {
      "cohort": "development_main only",
      "command": "python select_on_development.py --workers 16",
      "labels_used": true,
      "script": "experiments/select_on_development.py",
      "step": 3,
      "writes": [
        "results/detectors/development_candidates.csv",
        "results/detectors/development_selection.json"
      ]
    },
    {
      "cohort": "external_8b, single pass, no selection",
      "command": "python evaluate_on_external.py",
      "labels_used": true,
      "script": "experiments/evaluate_on_external.py",
      "step": 4,
      "writes": [
        "results/detectors/external_detectors.csv",
        "results/detectors/external_evaluation.json",
        "results/detectors/external_first_alarms.npz"
      ]
    },
    {
      "command": "python summarise_results.py",
      "script": "experiments/summarise_results.py",
      "step": 5,
      "writes": [
        "results/detectors/survival_conditioned_auc.csv",
        "results/detectors/external_detectors_with_ci.csv",
        "results/detectors/summary.json"
      ]
    },
    {
      "command": "python bootstrap_increment.py",
      "post_hoc": true,
      "script": "experiments/bootstrap_increment.py",
      "step": 6,
      "writes": [
        "results/detectors/bootstrap_increment.json"
      ]
    }
  ],
  "protocol_reuse": {
    "WIDTH/CONFIRMATIONS/MIN_LOW_PRIOR_PRECISION": "moe-hb-front-back-0905/experiments/compare_layers_early.py",
    "reproduction_check": "published baselines reproduce exactly: mobility|L12|low|0.975|global -> 195 TP / 17 FP, lift 1.7641; expert_load_effective_rank|L3|low|0.85|per_task -> 370 TP / 93 FP, lift 1.5479",
    "survival_prior/prior_of/score_candidate/LOW_PRIOR/MAX_TIMELY_FPR": "moe-hb-front-back-0905/experiments/select_early_lock.py",
